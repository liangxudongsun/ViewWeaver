{
  "name": "genbot",
  "version": "0.1.0",
  "description": "Cocos Creator extension that auto-generates typed View bindings from prefabs",
  "author": "h5_game_sh_tpe",
  "main": "./dist/main.js",
  "package_version": 2,
  "editor": ">=3.8.0",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . -w",
    "cli": "node ./dist/cli.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2"
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.assets/genbot",
        "label": "Generate View Binding",
        "message": "open-bind-editor"
      }
    ],
    "messages": {
      "open-bind-editor": {
        "methods": [
          "openBindEditor"
        ]
      },
      "regenerate-all": {
        "methods": [
          "regenerateAll"
        ]
      }
    }
  }
}
